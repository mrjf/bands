{
  "name": "@bands/server",
  "version": "0.1.0",
  "description": "Band execution server - enforces band restrictions and executes skills",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun && bun run build:worker",
    "build:worker": "bun build ./src/worker.ts --outdir ./dist --target browser --minify",
    "dev": "bun --watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bands/format": "workspace:*",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
