# Cloudflare credentials for integration tests
#
# API Token: https://dash.cloudflare.com/profile/api-tokens
#   Use the "Edit Cloudflare Workers" template
#
# Account ID: Found in the URL when logged into Cloudflare dashboard
#   e.g., https://dash.cloudflare.com/abc123def456 -> abc123def456
#   Or: Workers & Pages -> Overview -> Account ID (right sidebar)
#
CLOUDFLARE_API_TOKEN=your-token-here
CLOUDFLARE_ACCOUNT_ID=your-account-id-here
