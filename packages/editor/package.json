{
  "name": "@bands/editor",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/dev.ts",
    "build:client": "bun build ./src/public/app.ts --outdir ./src/public --target browser",
    "build": "bun build ./src/public/app.ts --outdir ./dist/public --minify && bun build ./src/server.ts --outdir ./dist --target bun",
    "start": "bun run dist/server.js",
    "test": "bun test"
  },
  "dependencies": {
    "@bands/format": "workspace:*",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
