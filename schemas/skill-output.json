{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skill-output.json",
  "title": "Skill Output",
  "description": "Output schema for skill execution results",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Whether the skill executed successfully"
    },
    "result": {
      "description": "The result of the skill execution - can be any type",
      "oneOf": [
        { "type": "string" },
        { "type": "object" },
        { "type": "array" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path"
          },
          "action": {
            "type": "string",
            "enum": ["created", "modified", "deleted"],
            "description": "What action was taken on the file"
          }
        },
        "required": ["path", "action"]
      },
      "description": "Files affected by the skill"
    },
    "message": {
      "type": "string",
      "description": "Human-readable summary of what was done"
    },
    "error": {
      "type": "string",
      "description": "Error message if success is false"
    }
  },
  "required": ["success"]
}
