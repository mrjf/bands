{
  "$id": "band.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "JSON Schema for BAND.md frontmatter",
  "type": "object",
  "properties": {
    "band": { "type": "string" },
    "icon": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "url": { "type": "string" },
    "path": { "type": "string" },
    "extends": { "type": "array", "items": { "type": "string" } },
    "includes": { "type": "array", "items": { "type": "string" } },
    "allow": { "$ref": "permission-categories.json" },
    "deny": { "$ref": "permission-categories.json" },
    "insist": { "$ref": "permission-categories.json" },
    "limit": { "$ref": "limits.json" },
    "env": { "$ref": "env-config.json" },
    "execution": { "$ref": "execution-config.json" },
    "requires": {
      "type": "object",
      "properties": {
        "secrets": { "type": "array", "items": { "type": "string" } },
        "network": {
          "type": "object",
          "properties": {
            "egress": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "properties": {
        "input": {},
        "output": {}
      },
      "additionalProperties": false
    }
  },
  "required": ["band", "icon", "description"],
  "additionalProperties": true
}
