      "$ref": "repo.json"
    },
    "title": {
      "type": "string",
      "description": "Issue title"
    },
    "body": {
      "type": "string",
      "description": "Issue body in markdown"
    },
    "labels": {
      "$ref": "labels-input.json"
    },
