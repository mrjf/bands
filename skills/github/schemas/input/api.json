{
  "type": "object",
  "properties": {
    "endpoint": {
      "type": "string",
      "description": "API endpoint path (e.g., repos/owner/repo/issues)"
    },
    "method": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "description": "HTTP method",
      "default": "GET"
    },
    "body": {
      "type": "object",
      "description": "Request body as JSON object"
    },
    "headers": {
      "type": "object",
      "description": "Additional HTTP headers as key-value pairs",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "endpoint"
  ]
}
