{
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "description": "Search query string"
    },
    "type": {
      "type": "string",
      "enum": ["issues", "prs", "repos", "code"],
      "description": "Type of search",
      "default": "issues"
    },
    "repo": {
      "type": "string",
      "description": "Filter by repository (owner/name format)"
    },
    "limit": {
      "type": "integer",
      "description": "Maximum number of results",
      "default": 30
    }
  },
  "required": ["query"]
}
