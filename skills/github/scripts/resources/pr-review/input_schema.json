{
  "type": "object",
  "properties": {
    "repo": {
      "type": "string",
      "description": "Repository in owner/name format"
    },
    "number": {
      "type": "integer",
      "description": "Pull request number"
    },
    "event": {
      "type": "string",
      "enum": ["APPROVE", "REQUEST_CHANGES", "COMMENT"],
      "description": "Review action",
      "default": "COMMENT"
    },
    "body": {
      "type": "string",
      "description": "Review comment body"
    }
  },
  "required": ["repo", "number", "body"]
}
