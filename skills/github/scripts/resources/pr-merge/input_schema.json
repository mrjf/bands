{
  "type": "object",
  "properties": {
    "repo": {
      "type": "string",
      "description": "Repository in owner/name format"
    },
    "number": {
      "type": "integer",
      "description": "Pull request number"
    },
    "method": {
      "type": "string",
      "enum": ["merge", "squash", "rebase"],
      "description": "Merge method",
      "default": "merge"
    },
    "delete_branch": {
      "type": "boolean",
      "description": "Delete the head branch after merging",
      "default": false
    }
  },
  "required": ["repo", "number"]
}
